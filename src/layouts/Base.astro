---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A personal recipe library — warm, searchable, and always at hand.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '') || '/';
const section = path.startsWith('/ingredients') ? 'ingredients' : path.startsWith('/products') ? 'products' : path.startsWith('/check') ? 'check' : 'recipes';
const nav = [
  { id: 'recipes', label: 'Recipes', href: `${base}/` },
  { id: 'ingredients', label: 'Ingredients', href: `${base}/ingredients/` },
  { id: 'products', label: 'Products', href: `${base}/products/` },
  { id: 'check', label: 'Check a label', href: `${base}/check/` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c4623c" />
    <title>{title}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={`${base}/`} aria-label="The Pantry — home">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3v7a3 3 0 0 0 6 0V3" />
              <path d="M9 10v11" />
              <path d="M17 3c-1.5 0-2.5 2-2.5 5.5S15.5 14 17 14s2.5-2 2.5-5.5S18.5 3 17 3Z" />
              <path d="M17 14v7" />
            </svg>
          </span>
          <span class="brand__text">The&nbsp;Pantry</span>
        </a>
        <p class="brand__tag">a personal recipe library</p>
        <nav class="site-nav" aria-label="Sections">
          {nav.map((n) => (
            <a href={n.href} class:list={['site-nav__link', { 'site-nav__link--on': section === n.id }]} aria-current={section === n.id ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <hr class="perforation" />
        <p>Kept by hand · built as a static cookbook · drop a markdown file in <code>/recipes</code> to add one.</p>
        <p class="site-footer__data">Ingredient scores rate the evidence on each ingredient, not the amount in a food, and are not medical advice. Product labels from USDA FoodData Central; additive names from Open Food Facts (ODbL).</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--paper) 82%, transparent);
        backdrop-filter: saturate(1.1) blur(6px);
        position: sticky;
        top: 0;
        z-index: 40;
      }
      .site-header__inner {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding-block: 0.85rem;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--ink);
      }
      .brand__mark {
        color: var(--paprika);
        display: inline-flex;
      }
      .brand__text {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .brand__tag {
        margin: 0;
        color: var(--ink-faint);
        font-size: 0.85rem;
        font-style: italic;
        font-family: var(--font-display);
      }
      .site-footer {
        margin-top: 4rem;
        padding-block: 1.5rem 3rem;
        color: var(--ink-faint);
        font-size: 0.85rem;
      }
      .site-footer .perforation { margin-bottom: 1.25rem; }
      .site-footer p { margin: 0 0 0.5rem; }
      .site-footer__data { max-width: 75ch; }
      .site-nav {
        margin-left: auto;
        display: flex;
        gap: 0.2rem;
        align-self: center;
      }
      .site-nav__link {
        text-decoration: none;
        color: var(--ink-soft);
        font-size: 0.92rem;
        font-weight: 550;
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
        white-space: nowrap;
      }
      .site-nav__link:hover { color: var(--ink); background: var(--paper-raised); }
      .site-nav__link--on { color: var(--paprika-deep); background: var(--paprika-wash); }
      @media (max-width: 900px) {
        .brand__tag { display: none; }
      }
      @media (max-width: 640px) {
        .site-header__inner { row-gap: 0.4rem; padding-block: 0.65rem; }
        .site-nav { margin-left: 0; flex-basis: 100%; overflow-x: auto; scrollbar-width: none; margin-inline: -0.5rem; }
        .site-nav__link { font-size: 0.88rem; padding: 0.35rem 0.6rem; }
      }
      .site-footer code {
        background: var(--paper-raised);
        padding: 0.1em 0.4em;
        border-radius: 4px;
        font-size: 0.85em;
      }

    </style>
  </body>
</html>
