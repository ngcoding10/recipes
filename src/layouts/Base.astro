---
import '@fontsource-variable/manrope';
import '@fontsource-variable/fraunces/full.css';
import '../styles/global.css';
import HeaderAccount from '../components/HeaderAccount.tsx';

interface Props {
  title: string;
  description?: string;
  /** Share image (absolute or site-relative path); defaults to the site card. */
  image?: string;
  noindex?: boolean;
}
const { title, description = 'A recipe library you can cook from, a new-recipe generator, and a label scanner that scores every ingredient.', image, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const site = (Astro.site?.origin ?? 'https://ngcoding10.github.io');
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), site).href;
const shareImage = image ? (image.startsWith('http') ? image : new URL(image, site).href) : `${site}${base}/og.jpg`;
const path = Astro.url.pathname.replace(/\/$/, '');
const rel = path.startsWith(base) ? path.slice(base.length) : path;
const current = (href: string) => (rel === href || (href === '' && rel === '') || (href === '/products' && rel.startsWith('/ingredients')) ? 'page' : undefined);

// Five destinations: the header on desktop, the tab bar on phones. Account sits in the header.
const NAV = [
  { href: '', label: 'Library', short: 'Library', icon: 'book' },
  { href: '/pantry', label: 'Cook', short: 'Cook', icon: 'basket' },
  { href: '/new', label: 'New recipe', short: 'New', icon: 'spark' },
  { href: '/scan', label: 'Scan', short: 'Scan', icon: 'camera' },
  { href: '/products', label: 'Products', short: 'Products', icon: 'barcode' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f0e6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1d1915" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // One-time cleanup: the site no longer takes a personal API key, so remove any saved on this device.
      try { localStorage.removeItem('pantry.anthropicKey'); } catch (e) {}
      // Apply a saved light/dark choice before first paint (no flash). "system" = follow the device.
      try { var t = localStorage.getItem('pantry.theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <script is:inline>
      // Shared-element page transition: the photo of the recipe you open grows into the recipe page,
      // and shrinks back into its card when you go back. Browsers without view transitions just load.
      (function () {
        var NAME = 'recipe-photo';
        var path = function (u) { try { return new URL(u, location.href).pathname.replace(/\/?$/, '/'); } catch (e) { return ''; } };
        var cardImg = function (p) { return p ? document.querySelector('a[href="' + p + '"] .card__media img, a[href="' + p.replace(/\/$/, '') + '"] .card__media img') : null; };
        var hero = function () { return document.querySelector('.recipe__hero'); };
        var mark = function (el, vt) { if (!el || !vt) return; el.style.viewTransitionName = NAME; vt.finished.finally(function () { el.style.viewTransitionName = ''; }); };
        addEventListener('pageswap', function (e) {
          if (!e.viewTransition || !e.activation || !e.activation.entry) return;
          var to = path(e.activation.entry.url);
          mark(hero() || cardImg(to), e.viewTransition);
        });
        addEventListener('pagereveal', function (e) {
          if (!e.viewTransition || !window.navigation || !navigation.activation || !navigation.activation.from) return;
          var from = path(navigation.activation.from.url);
          mark(hero() || cardImg(from), e.viewTransition);
        });
      })();
    </script>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="The Pantry" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Pantry" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5V5.5"/><path d="M20 18v3H6.5a2.5 2.5 0 0 1 0-5"/></symbol>
      <symbol id="i-basket" viewBox="0 0 24 24"><path d="M3 10h18l-1.6 9.2a2 2 0 0 1-2 1.8H6.6a2 2 0 0 1-2-1.8z"/><path d="M8 10 11 4"/><path d="m16 10-3-6"/><path d="M9 14v3"/><path d="M15 14v3"/><path d="M12 14v3"/></symbol>
      <symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13.5" r="3.5"/></symbol>
      <symbol id="i-barcode" viewBox="0 0 24 24"><path d="M4 6v12"/><path d="M7 6v12"/><path d="M11 6v12"/><path d="M14 6v12"/><path d="M18 6v12"/><path d="M20 6v12"/><path d="M2 4h2M20 4h2M2 20h2M20 20h2"/></symbol>
      <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3l1.8 4.9L19 9.7l-4.6 2.2L12 17l-2.4-5.1L5 9.7l5.2-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/></symbol>
      <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></symbol>
      <symbol id="i-gear" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></symbol>
    </svg>

    <header class="app-header">
      <div class="container app-header__inner">
        <a class="brand" href={`${base}/`} aria-label="The Pantry — home">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3v7a3 3 0 0 0 6 0V3" /><path d="M9 10v11" />
              <path d="M17 3c-1.5 0-2.5 2-2.5 5.5S15.5 14 17 14s2.5-2 2.5-5.5S18.5 3 17 3Z" /><path d="M17 14v7" />
            </svg>
          </span>
          <span class="brand__text">The Pantry</span>
        </a>
        <a id="from-ascoding-top" class="from-ascoding" href="https://ascoding11.github.io/" hidden>← ASCoding</a>
        <nav class="app-nav" aria-label="Primary">
          {NAV.map((n) => (
            <a class="app-nav__link" href={`${base}${n.href}/`.replace(/\/\/$/, '/')} aria-current={current(n.href)}>
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href={`#i-${n.icon}`} /></svg>
              <span>{n.label}</span>
            </a>
          ))}
        </nav>
        <HeaderAccount client:idle href={`${base}/account/`} current={current('/account') === 'page'} />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="app-footer">
      <div class="container">The Pantry · <a href={`${base}/privacy/`}>Privacy</a> · <a href={`${base}/terms/`}>Terms</a> · <a href={`${base}/ingredients/`}>Ingredient scores</a> · <a href="https://github.com/ngcoding10/recipes/issues">Feedback</a><span id="from-ascoding" hidden> · <a href="https://ascoding11.github.io/">Back to ASCoding</a></span><br />Scores are informational, not medical advice. Ingredient data includes Open Food Facts (ODbL) and USDA FoodData Central.</div>
    </footer>

    <script is:inline>
      // The same build is also served at ascoding11.github.io/recipes/; there, offer a way back.
      if (location.hostname === 'ascoding11.github.io') ['from-ascoding', 'from-ascoding-top'].forEach(function (id) { var el = document.getElementById(id); if (el) el.hidden = false; });
    </script>

    <nav class="tabbar" aria-label="Primary">
      <div class="tabbar__inner">
        {NAV.map((n) => (
          <a class="tabbar__link" href={`${base}${n.href}/`.replace(/\/\/$/, '/')} aria-current={current(n.href)}>
            <span class="tabbar__ico">
              <svg fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href={`#i-${n.icon}`} /></svg>
            </span>
            {n.short}
          </a>
        ))}
      </div>
    </nav>
  </body>
</html>
