---
// Old address: Settings moved to Account.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${base}/account/`} />
    <link rel="canonical" href={`${base}/account/`} />
    <title>Moved to Account — The Pantry</title>
  </head>
  <body><p>Settings moved to <a href={`${base}/account/`}>Account</a>.</p></body>
</html>
