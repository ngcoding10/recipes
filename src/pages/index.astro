---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RecipeLibrary from '../components/RecipeLibrary.tsx';
import { toRecipeData } from '../lib/collection';
import '../styles/library.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getCollection('recipes');
const recipes = entries.map((e) => toRecipeData(e, base));
---

<Base title="The Pantry — recipes, a new-recipe maker and a label scanner" description="91 recipes searchable by ingredient or codeword, a tool that writes new recipes from what you have, and a scanner that scores every ingredient on a label.">
  <section class="page-head container">
    <p class="page-head__eyebrow">The Pantry</p>
    <h1 class="page-head__title">Recipes <em>by codeword</em>.</h1>
    <p class="page-head__lede">{recipes.length} recipes, searchable by ingredient, codeword or tag. Pick a meal, add a keyword, and cook.</p>
  </section>

  <div class="container">
    <RecipeLibrary client:load recipes={recipes} base={base} />
  </div>
</Base>
