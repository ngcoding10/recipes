---
import Base from '../../layouts/Base.astro';
import IngredientList, { type IngredientRow } from '../../components/IngredientList.tsx';
import { INGREDIENTS } from '../../lib/ingredient-db';
import stats from '../../data/product-stats.json';
import '../../styles/tools.css';
import '../../styles/data.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items: IngredientRow[] = INGREDIENTS.map((d) => ({
  id: d.id,
  name: d.name,
  score: d.scanner ? d.scanner.score : null,
  carc: d.scanner?.carc ?? '',
  cls: d.class,
  why: d.scanner?.carcWhy || d.scanner?.why || d.evidence_note,
  products: d.products,
  search: [d.name, d.group, d.class, ...d.e_numbers, ...d.aliases.slice(0, 12), d.scanner?.name ?? ''].join(' ').toLowerCase(),
}));
const zero = items.filter((i) => i.score === 0).length;
---

<Base title="Ingredient database — The Pantry" description="Every questionable food ingredient on US labels, with its score and the evidence behind it.">
  <section class="page-head container container--narrow">
    <p class="page-head__eyebrow">Ingredient database</p>
    <h1 class="page-head__title">What's <em>in</em> the label.</h1>
    <p class="page-head__lede">
      {items.length} additives and questionable ingredients found across {stats.products.toLocaleString()} US food labels, with
      regulatory status, sources and how often each one appears. Scores match the Scan page: 0 means any cancer link.
    </p>
    <div class="db-links">
      <span><strong>{zero}</strong> score 0</span>
      <a href={`${base}/products/`}>Look up a product</a>
      <a href={`${base}/scan/`}>Scan a label</a>
    </div>
  </section>
  <div class="container container--narrow tools">
    <IngredientList client:load items={items} base={base} />
    <p class="tools__hint">
      A score of 0 means a cancer link exists somewhere in the evidence, not that the amount in a food is dangerous.
      Ingredients the scanner has no entry for are listed without a score. Informational, not medical advice.
    </p>
  </div>
</Base>
