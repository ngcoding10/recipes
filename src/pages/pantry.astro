---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pantry from '../components/Pantry.tsx';
import { toRecipeData } from '../lib/collection';
import '../styles/library.css';
import '../styles/recipe.css';
import '../styles/tools.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await getCollection('recipes');
const recipes = entries.map((e) => toRecipeData(e, base));
---

<Base title="Cook with what I have — The Pantry">
  <section class="page-head container">
    <p class="page-head__eyebrow">Cook with what I have</p>
    <h1 class="page-head__title">What's in the <em>fridge</em>?</h1>
    <p class="page-head__lede">List what you have. See which of your own recipes you can make right now, or have AI write a new one from exactly those ingredients.</p>
  </section>
  <div class="container tools">
    <Pantry client:load recipes={recipes} base={base} />
  </div>
</Base>
