{
  "name": "recipes",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "build:data": "python3 scripts/build-scores.py && python3 -I scripts/build-ingredients.py && node scripts/audit-scores.mjs --apply > /dev/null && node scripts/audit-scores.mjs",
    "build:synonyms": "python3 -I scripts/build-synonyms.py",
    "audit": "node scripts/audit-scores.mjs",
    "test": "node scripts/test-label.mjs",
    "build:products": "node data-pipeline/rescore.mjs",
    "test:emulators": "firebase emulators:exec --project demo-pantry --only auth,firestore,functions \"node scripts/emulator-test.mjs\"",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@astrojs/react": "^4.3.0",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^5.13.0",
    "firebase": "^13.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  }
}
